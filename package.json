{
  "name": "cosmossh",
  "version": "1.0.0",
  "description": "Next-generation SSH Terminal, SFTP Client & Host Manager with Cloudflare E2EE Sync",
  "homepage": "https://github.com/cosmossh/cosmossh",
  "main": "dist-electron/main/index.js",
  "author": "CosmoSSH Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.node.json",
    "build:electron": "tsc -p tsconfig.node.json",
    "dist:linux": "npm run build && electron-builder --linux deb AppImage",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "ssh2": "^1.16.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ssh2": "^1.15.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
